rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing recipe/profile data remains private to the signed-in owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Household, invitation, and shopping data can only be accessed through the
    // authenticated callable function, which validates membership in transactions.
    match /{document=**} { allow read, write: if false; }
  }
}
