	  <None Remove="Resources\Images\plus_icon_empty.png" />
	  <None Remove="Resources\Images\redo.png" />
	  <None Remove="Resources\Images\remove_icon.png" />
	  <None Remove="Resources\Images\restaurant.png" />
	  <None Remove="Resources\Images\salad.png" />
	  <None Remove="Resources\Images\save_icon.png" />
	  <None Remove="Resources\Images\search.png" />
	  <None Remove="Resources\Images\search_40.png" />
	  <None Remove="Resources\Images\search_icon.png" />
