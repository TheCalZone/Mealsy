	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.Core" Version="15.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
		<PackageReference Include="SQLiteNetExtensions" Version="2.1.0" />
		<PackageReference Include="SQLiteNetExtensions.Async" Version="2.1.0" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="UraniumUI.Material" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Effects\" />
	  <Folder Include="Platforms\Android\Services\" />
	  <Folder Include="Resources\AppiconIcon\" />
	</ItemGroup>
	
	<ItemGroup>
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" LogicalName="GoogleService-Info.plist" Condition="'$(TargetFramework)' == 'net10.0-ios'" />
	</ItemGroup>

	<ItemGroup>
		<GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="'$(TargetFramework)' == 'net10.0-android'" />
	</ItemGroup>
	
	<ItemGroup>
	  <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" Condition="'$(TargetFramework)' == 'net10.0-ios'" />
	</ItemGroup>
	
	<ItemGroup>
	  <MauiIcon Include="Resources\AppIcon\saladicon.svg" Color="#F5F7F2" Condition="'$(TargetFramework)' == 'net10.0-ios'" />
	</ItemGroup>
	
	<ItemGroup>
	  <Compile Update="Views\AccountPage.xaml.cs">
	    <DependentUpon>AccountPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Views\AccountPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\AddRecipePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\EditdetailsPage.xaml">
	    <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\EditExtraPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\EditRecipePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Homepage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\LoginPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MealPlannerPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MealPlanOverviewPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\RecipeDetailsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\RecipePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ShoppingListCreator.xaml">
	    <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ShoppingListMakerPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ShoppingListPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\SignupPage.xaml">
	    <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\TabbedPages\EssentialsForShoppingListPage.xaml">
	    <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\TabbedPages\RecipesForTabs.xaml">
	    <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\TabbedPages\SnacksForTabs.xaml">
	    <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
	  </MauiXaml>
	</ItemGroup>

    <Target Name="ValidateIosFirebaseConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' == 'net10.0-ios'">
        <Error Condition="!Exists('Platforms/iOS/GoogleService-Info.plist')" Text="Add the Firebase iOS app configuration to Platforms/iOS/GoogleService-Info.plist before building. See IOS_SETUP.md." />
    </Target>

    <!-- Swift extensions are built on the Mac before bundling. Opt in explicitly
         so legacy development builds do not claim to include missing extensions. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(EnableIosExtensions)' == 'true'">
        <DefineConstants>$(DefineConstants);IOS_EXTENSIONS</DefineConstants>
        <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(EnableIosExtensions)' == 'true'">
        <AdditionalAppExtensions Include="$(IosExtensionsDirectory)">
            <Name>MealsyShare</Name>
            <CodesignEntitlements>$(MSBuildProjectDirectory)/../native/ios/MealsyShare/MealsyShare.entitlements</CodesignEntitlements>
        </AdditionalAppExtensions>
        <AdditionalAppExtensions Include="$(IosExtensionsDirectory)">
            <Name>MealsyWidget</Name>
            <CodesignWarnIfNoEntitlements>false</CodesignWarnIfNoEntitlements>
        </AdditionalAppExtensions>
    </ItemGroup>
    <Target Name="ValidateIosExtensions" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(EnableIosExtensions)' == 'true'">
        <Error Condition="!Exists('$(IosExtensionsDirectory)/MealsyShare.appex/Info.plist') or !Exists('$(IosExtensionsDirectory)/MealsyWidget.appex/Info.plist')" Text="Build Swift extensions first and pass IosExtensionsDirectory. See native/ios/README.md." />
    </Target>

</Project>
