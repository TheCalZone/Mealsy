<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RecipeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RecipeApp.Views"
    xmlns:local1="clr-namespace:RecipeApp.Controls"
    Title="AppShell"
    BackgroundColor="{DynamicResource ThemeBackground}"
    Shell.FlyoutBehavior="Disabled">

    <!--
        The overall app visual hierarchy is defined here, along with navigation.
        
        https://docs.microsoft.com/xamarin/xamarin-forms/app-fundamentals/shell/
    -->

    <Shell.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#214D35</Color>
            <Color x:Key="AccentColor">#386347</Color>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ThemePrimary}" />
                <Setter Property="Shell.ForegroundColor" Value="White" />
                <Setter Property="Shell.TitleColor" Value="White" />
                <Setter Property="Shell.DisabledColor" Value="#B4FFFFFF" />
                <Setter Property="Shell.UnselectedColor" Value="#C3D4C3" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ThemePrimary}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="White" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="#C3D4C3" />
                <Setter Property="Shell.TabBarTitleColor" Value="White" />
            </Style>
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="TabBar" />
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="FlyoutItem" />
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource ThemeText}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="{DynamicResource ThemePrimary}" />
                <Setter Property="BarTextColor" Value="White" />
            </Style>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemeBackground}" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style TargetType="Image">
                <Setter Property="Aspect" Value="AspectFill" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemeAccent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{DynamicResource ThemeAccent}" />
                <Setter Property="ThumbColor" Value="LightGray" />
            </Style>

            <local1:AccountTabDataTemplateSelector x:Key="AccountTabDataTemplateSelector">
                <local1:AccountTabDataTemplateSelector.LoginPageTemplate>
                    <DataTemplate>
                        <local:LoginPage />
                    </DataTemplate>
                </local1:AccountTabDataTemplateSelector.LoginPageTemplate>
                <local1:AccountTabDataTemplateSelector.AccountPageTemplate>
                    <DataTemplate>
                        <local:AccountPage />
                    </DataTemplate>
                </local1:AccountTabDataTemplateSelector.AccountPageTemplate>
            </local1:AccountTabDataTemplateSelector>

        </ResourceDictionary>

    </Shell.Resources>

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:Homepage}"
            Icon="icon_feed.png"
            Route="Homepage" />
        <ShellContent
            Title="Recipes"
            ContentTemplate="{DataTemplate local:RecipePage}"
            Icon="icon_menu.png"
            Route="RecipePage" />
        <ShellContent
            Title="Shopping"
            ContentTemplate="{DataTemplate local:ShoppingListPage}"
            Icon="add_to_shopping.png"
            Route="ShoppingListPage" />
        <!--<ShellContent Title="Shopping" Icon="icon_list.png" Route="ShoppingListPage" ContentTemplate="{DataTemplate local:ShoppingListPage}" />-->
        <ShellContent
            Title="Meals"
            ContentTemplate="{DataTemplate local:MealPlanOverviewPage}"
            Icon="restaurant.png"
            Route="MealPlanOverviewPage" />
        <ShellContent
            Title="Account"
            ContentTemplate="{DataTemplate local:AccountPage}"
            Route="AccountPage" />
    </TabBar>

    <!--
        If you would like to navigate to this content you can do so by calling
        await Shell.Current.GoToAsync("//LoginPage");
    -->
    <!--
    <TabBar>
        <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate local:LoginPage}" />
    </TabBar>
    -->


</Shell>
