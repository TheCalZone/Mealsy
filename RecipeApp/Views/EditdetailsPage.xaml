<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.EditdetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <ContentPage.BindingContext>
        <viewmodels:EditdetailsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="15" Spacing="15">
                <Label
                    FontSize="Large"
                    HorizontalOptions="CenterAndExpand"
                    Text="Edit Your Details"
                    VerticalOptions="Start" />

                <Label Text="First Name *" />
                <Entry
                    x:Name="firstnameEntry"
                    Placeholder="Enter your first name"
                    Text="{Binding FirstName, Mode=TwoWay}" />

                <Label Text="Last Name" />
                <Entry
                    x:Name="lastnameEntry"
                    Placeholder="Enter your last name"
                    Text="{Binding LastName, Mode=TwoWay}" />

                <Label Text="Email Address *" />
                <Entry
                    x:Name="emailEntry"
                    IsReadOnly="True"
                    Placeholder="Enter your email address"
                    Text="{Binding Email, Mode=TwoWay}" />

                <Label Text="Dietary Requirements" />
                <Editor
                    x:Name="dietPicker"
                    Placeholder="Tell us about any dietary requirements"
                    Text="{Binding DietRestrictions, Mode=TwoWay}" />

                <Label Text="Favorite Cuisine" />
                <Entry
                    x:Name="favouriteCuisine"
                    Placeholder="Enter your favorite cuisine"
                    Text="{Binding FavouriteCuisines, Mode=TwoWay}" />

                <Button Command="{Binding SaveChangesCommand}" Text="Save Changes" />
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>


</ContentPage>
