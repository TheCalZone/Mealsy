<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:loc="clr-namespace:RecipeApp.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RecipeApp.Models"
             xmlns:vm="clr-namespace:RecipeApp.ViewModels"
             xmlns:views="clr-namespace:RecipeApp.Views"
             x:Class="RecipeApp.Views.ShoppingListPage"
             x:Name="ShoppingPage" Title="{loc:Translate 'Shopping list'}"
             BackgroundColor="{DynamicResource ThemeBackground}">
    <ContentPage.BindingContext><vm:ShoppingListViewModel /></ContentPage.BindingContext>
    <ContentPage.Resources>
        <views:UiTokenConverter x:Key="UiToken" />
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSubtle}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeText}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="MinimumWidthRequest" Value="48" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="{DynamicResource ThemeFont13}" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="Field" TargetType="Entry">
            <Setter Property="TextColor" Value="{DynamicResource ThemeText}" />
            <Setter Property="PlaceholderColor" Value="{DynamicResource ThemeMuted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="FontSize" Value="{DynamicResource ThemeFont16}" />
        </Style>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{loc:Translate 'Household'}" Clicked="Household_Clicked" />
        <ToolbarItem Text="{loc:Translate 'Plan from recipes &amp; checklists'}" Clicked="Creator_Clicked" Order="Secondary" />
        <ToolbarItem Text="{loc:Translate 'Home-screen quick add'}" Clicked="Widget_Clicked" Order="Secondary" />
        <ToolbarItem Text="{loc:Translate 'Sync now'}" Clicked="Sync_Clicked" Order="Secondary" />
        <ToolbarItem Text="{loc:Translate 'Resolve sync conflict'}" Clicked="Resolve_Clicked" Order="Secondary" />
        <ToolbarItem Text="{loc:Translate 'Paste list'}" Command="{Binding PasteCommand}" Order="Secondary" />
        <ToolbarItem Text="{loc:Translate 'Clear list'}" Command="{Binding ClearListCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16,8,16,8" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Grid x:Name="ShoppingModeBar" IsVisible="False" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Text="{loc:Translate 'Exit shopping'}" Clicked="ExitShopping_Clicked" HeightRequest="48" />
            <Label Grid.Column="1" Text="{Binding RemainingText}" VerticalOptions="Center" HorizontalTextAlignment="Center" TextColor="{DynamicResource ThemeText}" />
            <Button Grid.Column="2" Text="{loc:Translate 'Tools'}" Clicked="ShoppingTools_Clicked" Style="{StaticResource QuietButton}" />
        </Grid>
        <Border x:Name="ShoppingHeader" Padding="18,16" BackgroundColor="{DynamicResource ThemePrimary}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Button x:Name="ListSelector" Text="{loc:Translate 'Personal list ▾'}" Clicked="ListSelector_Clicked" BackgroundColor="Transparent" TextColor="#C3DAC8" Padding="0" HorizontalOptions="Start" HeightRequest="44" />
                        <Label Text="{Binding ProgressText}" FontSize="{DynamicResource ThemeFont22}" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="10,5" StrokeThickness="0" BackgroundColor="{DynamicResource ThemeAccent}" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                        <Label Text="{Binding RemainingText}" FontSize="{DynamicResource ThemeFont12}" TextColor="White" />
                    </Border>
                </Grid>
                <ProgressBar Progress="{Binding Progress}" ProgressColor="White" BackgroundColor="{DynamicResource ThemeAccent}" HeightRequest="6" SemanticProperties.Description="Shopping progress" />
                <views:MembershipPrompt x:Name="ShoppingMembership" />
                <Button Text="{loc:Translate 'Go shopping'}" Clicked="GoShopping_Clicked" BackgroundColor="White" TextColor="{DynamicResource ThemePrimary}" HeightRequest="48" />
            </VerticalStackLayout>
        </Border>

        <Border x:Name="ShoppingTools" Grid.Row="1" Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                BackgroundColor="{DynamicResource ThemeSurface}">
            <VerticalStackLayout Spacing="5">
                <Grid ColumnDefinitions="*,68,64" ColumnSpacing="7">
                    <Entry x:Name="QuickAddEntry" Style="{StaticResource Field}" Text="{Binding QuickName}" Placeholder="{loc:Translate 'What do you need?'}"
                           ReturnType="Done" ReturnCommand="{Binding AddItemCommand}" ClearButtonVisibility="WhileEditing" SemanticProperties.Description="New shopping item" />
                    <Entry x:Name="QuickQuantityEntry" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding QuickQuantity}" Placeholder="{loc:Translate 'Qty'}" SemanticProperties.Description="Optional quantity or unit" />
                    <Button Grid.Column="2" Text="{loc:Translate 'Add'}" Command="{Binding AddItemCommand}" BackgroundColor="{DynamicResource ThemePrimary}" TextColor="White"
                            HeightRequest="48" CornerRadius="12" Padding="8,0" Margin="0" FontAttributes="Bold" />
                </Grid>
                <views:IngredientSuggestionsView x:Name="QuickSuggestions" />
                <Button Text="Checked item settings" Clicked="CheckedItemSettings_Clicked" Style="{StaticResource QuietButton}" />
                <Button Text="{loc:Translate 'Reorder sections'}" Clicked="ReorderSections_Clicked" Style="{StaticResource QuietButton}" />
                <Button Text="{loc:Translate 'Category &amp; note'}" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                <Grid IsVisible="{Binding ShowDetails}" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Picker Title="{loc:Translate 'Category'}" ItemDisplayBinding="{Binding ., Converter={StaticResource UiToken}}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                            TextColor="{DynamicResource ThemeText}" SemanticProperties.Description="Category for new items" />
                    <Entry Grid.Row="1" Style="{StaticResource Field}" Text="{Binding QuickNote}" Placeholder="{loc:Translate 'Optional note, e.g. ripe or gluten-free'}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <SearchBar Text="{Binding SearchText}" Placeholder="{loc:Translate 'Find an item'}" BackgroundColor="Transparent"
                               TextColor="{DynamicResource ThemeText}" CancelButtonColor="{DynamicResource ThemeAccent}" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{loc:Translate 'Hide collected'}" FontSize="{DynamicResource ThemeFont12}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                        <Switch IsToggled="{Binding HideCollected}" OnColor="{DynamicResource ThemeAccent}" ThumbColor="{DynamicResource ThemeOnAccent}" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="28,36" Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{Binding EmptyTitle}" FontSize="{DynamicResource ThemeFont22}" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource ThemeText}" />
                    <Label Text="{Binding EmptyMessage}" FontSize="{DynamicResource ThemeFont15}" HorizontalTextAlignment="Center" MaximumWidthRequest="310"
                           TextColor="{DynamicResource ThemeText}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ShoppingListGroup">
                    <Grid Padding="4,12,4,8" ColumnDefinitions="*,Auto,48" Loaded="SectionHeader_Loaded">
                        <Label Text="{Binding Title, Converter={StaticResource UiToken}}" FontSize="{DynamicResource ThemeFont16}" FontAttributes="Bold" TextColor="{DynamicResource ThemeText}" />
                        <Label Grid.Column="1" Text="{Binding Summary}" FontSize="{DynamicResource ThemeFont12}" VerticalOptions="Center" TextColor="{DynamicResource ThemeText}" />
                        <Label x:Name="SectionMoveHandle" Grid.Column="2" Text="☰" FontSize="20" WidthRequest="48" HeightRequest="48"
                               VerticalTextAlignment="Center" HorizontalTextAlignment="Center" TextColor="{DynamicResource ThemeText}"
                               SemanticProperties.Description="{Binding Title, StringFormat='Move section: {0}'}"
                               SemanticProperties.Hint="Touch and move this icon to reorder the section. Hold near the top or bottom edge to scroll slowly. The rest of the header scrolls normally." />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ShoppingListItem">
                    <SwipeView IsVisible="{Binding Source={x:Reference ShoppingPage}, Path=BindingContext.ShowSectionIngredients}"
                               HeightRequest="{Binding Source={x:Reference ShoppingPage}, Path=BindingContext.IngredientRowHeight}" MinimumHeightRequest="0">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="{loc:Translate 'Edit'}" BackgroundColor="{DynamicResource ThemeAccent}" Command="{Binding Source={x:Reference ShoppingPage}, Path=BindingContext.EditItemCommand}" CommandParameter="{Binding .}" />
                                <SwipeItem Text="{loc:Translate 'Remove'}" BackgroundColor="#9A4840" Command="{Binding Source={x:Reference ShoppingPage}, Path=BindingContext.RemoveItemCommand}" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Loaded="ItemRow_Loaded" Margin="0,0,0,7" Padding="8,10,10,10" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource ThemeSurface}">
                            <Grid ColumnDefinitions="48,*,48" ColumnSpacing="5" MinimumHeightRequest="48">
                                <CheckBox IsChecked="{Binding InBasket, Mode=TwoWay}" Color="{DynamicResource ThemeAccent}" VerticalOptions="Center"
                                          SemanticProperties.Description="{Binding Name, StringFormat='Collected: {0}'}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ShoppingPage}, Path=BindingContext.ToggleItemCommand}" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Name}" FontSize="{DynamicResource ThemeFont17}" TextColor="{DynamicResource ThemeText}" LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding InBasket}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Quantity}" IsVisible="{Binding HasQuantity}" FontSize="{DynamicResource ThemeFont14}" FontAttributes="Bold"
                                           TextColor="{DynamicResource ThemeText}" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="{DynamicResource ThemeFont12}" TextColor="{DynamicResource ThemeText}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="☰" FontSize="20" TextColor="{DynamicResource ThemeText}"
                                       HeightRequest="48" WidthRequest="48" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"
                                       Loaded="ItemHandle_Loaded" SemanticProperties.Description="{Binding Name, StringFormat='Drag handle for {0}'}"
                                       SemanticProperties.Hint="Touch and hold the handle while moving up or down within this section. Hold near the top or bottom edge to scroll slowly. No long-press delay on Android. Swipe the item to edit." />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="5">
            <Grid x:Name="ShoppingFooterActions" ColumnDefinitions="*,*,*,*" ColumnSpacing="7">
                <Button Text="{loc:Translate 'Undo'}" Command="{Binding UndoCommand}" Style="{StaticResource QuietButton}" />
                <Button Grid.Column="1" Text="{loc:Translate 'Redo'}" Command="{Binding RedoCommand}" Style="{StaticResource QuietButton}" />
                <Button Grid.Column="2" Text="Clear done" Command="{Binding ClearCollectedCommand}" Style="{StaticResource QuietButton}" Padding="4,0" FontSize="{DynamicResource ThemeFont12}" />
                <Button Grid.Column="3" Text="Share" Command="{Binding ShareCommand}" Style="{StaticResource QuietButton}" />
            </Grid>
            <Label Text="{Binding StatusText}" FontSize="{DynamicResource ThemeFont11}" HorizontalTextAlignment="Center" TextColor="{DynamicResource ThemeText}" SemanticProperties.Description="Save status" />
        </VerticalStackLayout>

        <Grid Grid.RowSpan="4" IsVisible="{Binding IsEditing}" BackgroundColor="#99000000" Padding="4" ZIndex="10">
            <Border Padding="20" StrokeThickness="0" StrokeShape="RoundRectangle 22" VerticalOptions="Center"
                    BackgroundColor="{DynamicResource ThemeSurface}">
                <ScrollView MaximumHeightRequest="500">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Edit item" FontSize="{DynamicResource ThemeFont23}" FontAttributes="Bold" TextColor="{DynamicResource ThemeText}" />
                        <Label Text="ITEM NAME" FontSize="{DynamicResource ThemeFont11}" TextColor="{DynamicResource ThemeText}" />
                        <Entry Text="{Binding EditName}" Style="{StaticResource Field}" Placeholder="{loc:Translate 'Item name'}" />
                        <Label Text="QUANTITY / UNIT" FontSize="{DynamicResource ThemeFont11}" TextColor="{DynamicResource ThemeText}" />
                        <Entry Text="{Binding EditQuantity}" Style="{StaticResource Field}" Placeholder="e.g. 2 packs or 500 g" />
                        <Label Text="CATEGORY" FontSize="{DynamicResource ThemeFont11}" TextColor="{DynamicResource ThemeText}" />
                        <Entry Text="{Binding EditCategory}" Style="{StaticResource Field}" Placeholder="e.g. Produce or Household" />
                        <Label Text="NOTE" FontSize="{DynamicResource ThemeFont11}" TextColor="{DynamicResource ThemeText}" />
                        <Entry Text="{Binding EditNote}" Style="{StaticResource Field}" Placeholder="Optional detail" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button Text="{loc:Translate 'Cancel'}" Command="{Binding CancelEditCommand}" Style="{StaticResource QuietButton}" />
                            <Button Grid.Column="1" Text="{loc:Translate 'Save item'}" Command="{Binding SaveEditCommand}" HeightRequest="48" CornerRadius="12"
                                    BackgroundColor="{DynamicResource ThemePrimary}" TextColor="White" Margin="0" FontAttributes="Bold" />
                        </Grid>
                        <Button Text="Remove this item" Clicked="RemoveEditingItem_Clicked" BackgroundColor="Transparent" TextColor="{DynamicResource ThemeText}"
                                HeightRequest="48" Margin="0" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
