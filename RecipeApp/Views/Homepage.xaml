<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.Homepage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    Title="Homepage">

    <ContentPage.BindingContext>
        <viewmodels:HomepageViewModel />
    </ContentPage.BindingContext>

    <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">

        <!--<Image
            Margin="0,0,0,20"
            HeightRequest="250"
            Source="logo.png" />-->

        <Border
            Margin="0,0,0,20"
            Padding="5,10,5,5"
            BackgroundColor="Beige"
            HorizontalOptions="FillAndExpand"
            StrokeThickness="4">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25,25,25,25" />
            </Border.StrokeShape>
            <StackLayout
                HorizontalOptions="CenterAndExpand"
                Orientation="Horizontal"
                VerticalOptions="FillAndExpand">
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding QuickAddToShoppingListCommand}"
                    ImageSource="add_to_shopping.png" />
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding QuickAddNewRecipeCommand}"
                    ImageSource="recipeadd.png" />
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding QuickAddToShoppingListCommand}"
                    ImageSource="add_to_shopping.png" />
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding QuickAddToShoppingListCommand}"
                    ImageSource="add_to_shopping.png" />
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding QuickAddToShoppingListCommand}"
                    ImageSource="add_to_shopping.png" />
            </StackLayout>
        </Border>


        <Button Command="{Binding RecipeBookCommand}" Text="Recipe Book" />

        <Button Command="{Binding ListMakerCommand}" Text="Shopping List Creator" />

        <Button Command="{Binding ShoppingListCommand}" Text="Shopping List" />

        <Button Command="{Binding MealPlannerCommand}" Text="Meal Planner" />

    </StackLayout>

</ContentPage>
