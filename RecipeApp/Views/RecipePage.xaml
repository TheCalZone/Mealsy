<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.RecipePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:RecipeApp.Converter"
    xmlns:model="clr-namespace:RecipeApp.Models"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="RecipeBook"
    Title="Recipes"
    x:DataType="viewmodels:RecipeViewModel">


    <ContentPage.BindingContext>
        <viewmodels:RecipeViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding CreateNewRecipe}" Text="+" />
        <ToolbarItem Command="{Binding ToggleSearchBarCommand}" Text="search" />
        <ToolbarItem Command="{Binding ShowHelpCommand}" Text="?"/>
    </ContentPage.ToolbarItems>


    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter" />
            <xct:ItemTappedEventArgsConverter x:Key="ItemTappedEventArgsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout
                Padding="10,5"
                IsVisible="{Binding SearchBarIsActive}"
                Orientation="Horizontal">
                <SearchBar
                    HeightRequest="40"
                    HorizontalOptions="StartAndExpand"
                    Placeholder="Search Recipes"
                    Text="{Binding SearchText}"
                    WidthRequest="250" />
                <Picker
                    Title="Filter by"
                    Margin="10,0,0,0"
                    ItemsSource="{Binding Filters}"
                    SelectedItem="{Binding SelectedFilter}"
                    VerticalOptions="CenterAndExpand" />
                <Button
                    Margin="0"
                    BackgroundColor="Transparent"
                    Command="{Binding ClearPickerSelectionCommand}"
                    Text="x" />
            </StackLayout>
            <ListView
                x:Name="listView"
                Grid.Row="0"
                HasUnevenRows="True"
                IsPullToRefreshEnabled="True"
                IsRefreshing="{Binding IsBusy, Mode=TwoWay}"
                ItemsSource="{Binding Recipes}"
                RefreshCommand="{Binding RefreshCommand}"
                SelectedItem="{Binding SelectedRecipe, Mode=OneWay}"
                SelectionMode="None"
                SeparatorVisibility="None"
                VerticalOptions="FillAndExpand">

                <ListView.Behaviors>
                    <xct:EventToCommandBehavior
                        Command="{Binding SelectedCommand}"
                        EventArgsConverter="{StaticResource ItemTappedEventArgsConverter}"
                        EventName="ItemTapped" />
                </ListView.Behaviors>

                <ListView.Footer>
                    <Button Command="{Binding CreateNewRecipe}" Text="New Recipe" />
                </ListView.Footer>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Recipe">
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Favourite" />
                                <MenuItem
                                    Command="{Binding Source={x:Reference RecipeBook}, Path=BindingContext.DeleteRecipeCommand}"
                                    CommandParameter="{Binding .}"
                                    IsDestructive="True"
                                    Text="Delete" />
                            </ViewCell.ContextActions>
                            <Border
                                Margin="10"
                                Padding="0"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Grid>
                                    <Image
                                        Aspect="AspectFill"
                                        BackgroundColor="LightGray"
                                        HeightRequest="200"
                                        Source="{Binding RecipeImage, Converter={StaticResource Base64ToImageSourceConverter}}" />
                                    <Grid BackgroundColor="#FFC057" VerticalOptions="End">
                                        <StackLayout HorizontalOptions="FillAndExpand" Spacing="5">
                                            <Label Text="{Binding FirebaseUID}" />
                                            <Label
                                                Margin="0,0,0,-10"
                                                FontAttributes="Bold"
                                                FontSize="25"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding RecipeName}"
                                                TextColor="White"
                                                VerticalOptions="End" />
                                            <Grid
                                                Padding="10"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="FillAndExpand">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        FontSize="14"
                                                        Text="Serving Size: "
                                                        TextColor="White" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="16"
                                                        LineBreakMode="NoWrap"
                                                        Text="{Binding Serving}"
                                                        TextColor="White" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Column="1"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        FontSize="14"
                                                        Text="Total time (min): "
                                                        TextColor="White" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="16"
                                                        LineBreakMode="NoWrap"
                                                        Text="{Binding TotalTime}"
                                                        TextColor="White" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Column="2"
                                                    HorizontalOptions="EndAndExpand"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        FontSize="14"
                                                        Text="Rating: "
                                                        TextColor="White" />
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="16"
                                                        LineBreakMode="NoWrap"
                                                        Text="{Binding Rating}"
                                                        TextColor="White" />
                                                </StackLayout>
                                            </Grid>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </Border>


                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Command="{Binding DeleteAllRecipesCommand}" Text="Delete All Recipes" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>