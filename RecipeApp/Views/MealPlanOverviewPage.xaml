<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.MealPlanOverviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:RecipeApp.Converter"
    xmlns:model="clr-namespace:RecipeApp.Models"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    Title="Meal Planner">

    <ContentPage.BindingContext>
        <viewmodels:MealPlanOverviewViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter" />
            <behaviors:ItemTappedEventArgsConverter x:Key="ItemTappedEventArgsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <StackLayout>
            <ListView
                HasUnevenRows="True"
                ItemsSource="{Binding MealPlan.Days, Mode=TwoWay}"
                SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                SelectionMode="None"
                SeparatorVisibility="Default">
                <ListView.Behaviors>
                    <behaviors:EventToCommandBehavior
                        Command="{Binding SelectMealPlanDayCommand}"
                        CommandParameter="{Binding SelectedDay.MealDayIndex}"
                        EventArgsConverter="{StaticResource ItemTappedEventArgsConverter}"
                        EventName="ItemTapped" />
                </ListView.Behaviors>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:MealPlanDay">
                        <ViewCell>
                            <Border
                                Margin="10"
                                Padding="5,5,5,15"
                                BackgroundColor="Gray">
                                <StackLayout Spacing="15">
                                    <Label
                                        Padding="5"
                                        BackgroundColor="#FF6347"
                                        FontAttributes="Bold"
                                        FontSize="Large"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding MealDay}"
                                        TextColor="White" />

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="Medium"
                                        Text="Breakfast" />
                                    <Label BackgroundColor="Transparent" Text="{Binding Breakfast, Mode=TwoWay}" />

                                    <Frame BackgroundColor="DimGray" IsVisible="{Binding IsBreakfastExtrasVisible}">
                                        <StackLayout>
                                            <Label Text="Extras" />
                                            <CollectionView ItemsSource="{Binding BreakfastRecipes}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="model:Recipe">
                                                        <Label Text="{Binding RecipeName}" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                            <Label Text="Notes" />
                                            <CollectionView ItemsSource="{Binding BreakfastNotes}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding .}" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </StackLayout>
                                    </Frame>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="Medium"
                                        Text="Lunch" />
                                    <Label BackgroundColor="Transparent" Text="{Binding Lunch, Mode=TwoWay}" />


                                    <Frame BackgroundColor="DimGrey" IsVisible="{Binding IsLunchExtrasVisible}">
                                        <StackLayout>
                                            <Label Text="Extras" />
                                            <CollectionView ItemsSource="{Binding LunchRecipes}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="model:Recipe">
                                                        <Label Text="{Binding RecipeName}" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                            <Label Text="Notes" />
                                            <CollectionView ItemsSource="{Binding LunchNotes}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding .}" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </StackLayout>
                                    </Frame>


                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="Medium"
                                        Text="Dinner" />
                                    <Label BackgroundColor="Transparent" Text="{Binding Dinner, Mode=TwoWay}" />
                                    <Frame BackgroundColor="DimGray" IsVisible="{Binding IsDinnerExtrasVisible}">
                                        <StackLayout>
                                            <Label Text="Extras" />
                                            <CollectionView ItemsSource="{Binding DinnerRecipes}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="model:Recipe">
                                                        <Label Text="{Binding RecipeName}" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                            <Label Text="Notes" />
                                            <CollectionView ItemsSource="{Binding DinnerNotes}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding .}" />
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>

                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
            <Button
                Margin="5"
                Command="{Binding ClearMealPlanCommand}"
                Text="Clear meal plan" />
            <!--<Button
                Margin="5"
                Command="{Binding AddDayCommand}"
                Text="Add mealplan for testing" />
            <Button
                Margin="5"
                Command="{Binding DeleteMealPlanDayCommand}"
                Text="Delete mealplan for testing" />-->

            <Button
                Margin="5"
                Command="{Binding ShopMealPlanCommand}"
                Text="Add meals to shopping list" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>