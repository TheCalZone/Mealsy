<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
             x:Class="RecipeApp.Views.EditExtraPage">

    <ContentPage.BindingContext>
        <viewmodels:EditExtraViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <StackLayout>
            <Entry Text="{Binding Snack.Name}" TextColor="Black" IsVisible="{Binding SnackNull}"/>
            <Entry Text="{Binding Snack.Tag}" TextColor="Black" IsVisible="{Binding SnackNull}"/>
            <Entry Text="{Binding Staple.Name}" TextColor="Black" IsVisible="{Binding StapleNull}"/>
            <Entry Text="{Binding Staple.Tag}" TextColor="Black" IsVisible="{Binding StapleNull}"/>
            <Button Text="Save" Command="{Binding SaveCommand}" CommandParameter="{Binding .}"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>