<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.EditRecipePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="EditRecipe"
    Title="Edit Recipe"
    NavigationPage.HasBackButton="True">


    <ContentPage.BindingContext>
        <viewmodels:EditRecipeViewModel />
    </ContentPage.BindingContext>


    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding SaveCommand}"
            IconImageSource="save_icon.png"
            Text="Save" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout
                Margin="0,10,0,10"
                Padding="10"
                HorizontalOptions="FillAndExpand"
                Spacing="10">
                <Label
                    Padding="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Recipe Name:" />
                <Entry
                    FontSize="18"
                    Placeholder="Enter recipe name"
                    Text="{Binding Recipe.RecipeName}" />
                <xct:Expander x:Name="ImageExpander" IsExpanded="False">
                    <xct:Expander.Header>
                        <StackLayout Orientation="Horizontal">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Image" />
                            <Image
                                Margin="5,5,0,0"
                                HeightRequest="18"
                                Source="ExpandMore.png"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                        </StackLayout>
                    </xct:Expander.Header>
                    <StackLayout Margin="0,10,0,0">
                        <Frame Padding="0" CornerRadius="15">
                            <Image
                                Aspect="AspectFill"
                                BackgroundColor="LightGray"
                                HeightRequest="200"
                                Source="{Binding RecipeImage, Mode=TwoWay}"
                                WidthRequest="400" />
                        </Frame>
                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Button
                                BackgroundColor="#2196F3"
                                Command="{Binding UploadImageCommand}"
                                CommandParameter="{Binding Id}"
                                CornerRadius="5"
                                Text="Upload Image"
                                TextColor="White"
                                VerticalOptions="End" />
                            <Button
                                Margin="5"
                                BackgroundColor="#2196F3"
                                Command="{Binding UploadImageCommand}"
                                CommandParameter="{Binding Id}"
                                CornerRadius="5"
                                Text="Clear Image"
                                TextColor="White"
                                VerticalOptions="End" />
                        </HorizontalStackLayout>
                    </StackLayout>
                </xct:Expander>

                <xct:Expander x:Name="IngredientsExpander" IsExpanded="true">
                    <xct:Expander.Header>
                        <StackLayout Orientation="Horizontal" Padding="0,0,0,6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Ingredients" />
                            <Image
                                Margin="10,0,0,0"
                                HeightRequest="18"
                                Source="ExpandMore.png"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                        </StackLayout>
                    </xct:Expander.Header>
                    <StackLayout VerticalOptions="FillAndExpand">

                        <!--  Header Grid  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <!--  For CheckBox  -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="15"
                                HorizontalOptions="Start"
                                Text="Quantity" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="15"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                Text="Name" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="15"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Center"
                                Text="Tag" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="3"
                                FontAttributes="Bold"
                                FontSize="15"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Center"
                                Text="Key" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="4"
                                FontAttributes="Bold"
                                FontSize="15"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Center"
                                Text="Note" />

                            <ListView
                                Grid.Row="1"
                                Grid.ColumnSpan="6"
                                HasUnevenRows="True"
                                ItemsSource="{Binding Ingredients, Mode=TwoWay}"
                                SelectionMode="None"
                                SeparatorColor="Black"
                                SeparatorVisibility="Default"
                                VerticalOptions="FillAndExpand"
                                VerticalScrollBarVisibility="Always">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Entry
                                                    Grid.Column="0"
                                                    Placeholder="Quantity"
                                                    Text="{Binding Quantity}" />

                                                <Entry
                                                    Grid.Column="1"
                                                    Placeholder="Name"
                                                    Text="{Binding Name}" />

                                                <Entry
                                                    Grid.Column="2"
                                                    Placeholder="Tag"
                                                    Text="{Binding Tag}" />

                                                <CheckBox
                                                    Grid.Column="3"
                                                    IsChecked="{Binding MainIngredient}"
                                                    VerticalOptions="Center" 
                                                    HorizontalOptions="Center"/>

                                                <Button
                                                    Grid.Column="5"
                                                    Margin="0,0,10,0"
                                                    BackgroundColor="Transparent"
                                                    Command="{Binding Source={x:Reference EditRecipe}, Path=BindingContext.DeleteIngredientCommand}"
                                                    CommandParameter="{Binding .}"
                                                    HorizontalOptions="End"
                                                    ImageSource="minus.png"
                                                    Scale="0.75" />
                                                <ImageButton
                                                    Grid.Column="4"
                                                    Command="{Binding Source={x:Reference EditRecipe}, Path=BindingContext.AddNoteCommand, Mode=TwoWay}"
                                                    CommandParameter="{Binding .}"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Scale="0.75"
                                                    Source="add_note">
                                                    <ImageButton.Behaviors>
                                                        <xct:IconTintColorBehavior TintColor="{Binding Source={x:Reference EditRecipe}, Path=BindingContext.IconColor}" />
                                                    </ImageButton.Behaviors>
                                                </ImageButton>
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                        </Grid>

                        <!--  ListView with Grid  -->

                        <Button
                            BackgroundColor="#4CAF50"
                            Command="{Binding AddIngredientCommand}"
                            CornerRadius="5"
                            Text="Add Ingredient"
                            TextColor="White"
                            VerticalOptions="End" />
                    </StackLayout>

                </xct:Expander>


                <!--  Recipe Tags Section  -->
                <xct:Expander x:Name="TagsExpander" IsExpanded="False">
                    <xct:Expander.Header>
                        <StackLayout Orientation="Horizontal">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Recipe Tags" />
                            <Image
                                Margin="10,0,0,0"
                                HeightRequest="18"
                                Source="ExpandMore.png"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                        </StackLayout>
                    </xct:Expander.Header>
                    <StackLayout>
                        <Entry Placeholder="Tags - Separated by ','" Text="{Binding Recipe.Tags}" />
                    </StackLayout>
                </xct:Expander>

                <!--  Recipe Method Section  -->
                <xct:Expander x:Name="MethodExpander" IsExpanded="False">
                    <xct:Expander.Header>
                        <StackLayout Orientation="Horizontal">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Recipe Method" />
                            <Image
                                Margin="10,0,0,0"
                                HeightRequest="18"
                                Source="ExpandMore.png"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                        </StackLayout>
                    </xct:Expander.Header>
                    <StackLayout>
                        <Frame
                            Margin="10"
                            BackgroundColor="#F5F5F5"
                            CornerRadius="10"
                            HasShadow="True">
                            <Editor
                                Margin="0"
                                AutoSize="TextChanges"
                                FontSize="18"
                                HeightRequest="300"
                                Placeholder="Recipe Method"
                                PlaceholderColor="Black"
                                Text="{Binding Recipe.RecipeMethod}"
                                TextColor="Black" />
                        </Frame>
                    </StackLayout>
                </xct:Expander>

                <xct:Expander x:Name="Optional" IsExpanded="False">
                    <xct:Expander.Header>
                        <StackLayout Margin="0,0,0,10" Orientation="Horizontal">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Optional" />
                            <Image
                                Margin="10,0,0,0"
                                HeightRequest="18"
                                Source="ExpandMore.png"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                        </StackLayout>
                    </xct:Expander.Header>
                    <StackLayout>
                        <Label FontAttributes="Bold" Text="Serving Size" />
                        <Entry
                            Placeholder="Enter a number."
                            PlaceholderColor="#373737"
                            Text="{Binding Recipe.Serving}">
                            <Entry.Behaviors>
                                <xct:NumericValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    MaximumValue="1000.0"
                                    MinimumValue="1.0" />
                            </Entry.Behaviors>
                        </Entry>
                        <Label FontAttributes="Bold" Text="Prep Time" />
                        <Entry
                            Placeholder="Enter a number."
                            PlaceholderColor="#373737"
                            Text="{Binding Recipe.PrepTime}">
                            <Entry.Behaviors>
                                <xct:NumericValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    MaximumValue="1000.0"
                                    MinimumValue="1.0" />
                            </Entry.Behaviors>
                        </Entry>
                        <Label FontAttributes="Bold" Text="Rating" />
                        <Entry
                            Placeholder="Enter a number up to 5."
                            PlaceholderColor="#373737"
                            Text="{Binding Recipe.Rating}">
                            <Entry.Behaviors>
                                <xct:NumericValidationBehavior
                                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                                    MaximumValue="5.0"
                                    MinimumValue="1.0" />
                            </Entry.Behaviors>
                        </Entry>
                    </StackLayout>
                </xct:Expander>

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>