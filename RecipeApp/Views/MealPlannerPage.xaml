<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.MealPlannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:RecipeApp.Converter"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    x:Name="MealPlannner"
    Title="Meal Plan">

    <ContentPage.BindingContext>
        <viewmodels:MealPlannerViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout Margin="10" Spacing="10">
                <Label
                    Margin="0,0,0,10"
                    FontAttributes="Bold"
                    FontSize="Large"
                    HorizontalOptions="Center"
                    Text="{Binding SelectedDay.MealDay}"
                    TextDecorations="Underline" />
                <Frame BackgroundColor="DimGrey">
                    <StackLayout>
                        <!--  Breakfast Section  -->
                        <Label FontAttributes="Bold" Text="Breakfast" />
                        <Picker
                            x:Name="BreakfastPicker"
                            Title="Select a Recipe"
                            ItemDisplayBinding="{Binding RecipeName}"
                            ItemsSource="{Binding Recipes}"
                            SelectedItem="{Binding SelectedBreakfast, Mode=TwoWay}" />
                        <!--  Add Recipe Button for Breakfast  -->
                        <HorizontalStackLayout>
                            <Label Text="Extras" />
                            <ImageButton
                                Margin="-10,-12,-10,-10"
                                Command="{Binding AddBreakFastRecipeCommand}"
                                Scale="0.5"
                                Source="plus_icon" />
                        </HorizontalStackLayout>
                        <CollectionView ItemsSource="{Binding SelectedDay.BreakfastRecipes, Mode=TwoWay}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Padding="5" Text="{Binding RecipeName}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <HorizontalStackLayout>
                            <Label Text="Notes" />
                            <ImageButton
                                Margin="-10"
                                Command="{Binding AddBreakFastNoteCommand}"
                                Scale="0.5"
                                Source="add_note" />
                        </HorizontalStackLayout>
                        <CollectionView ItemsSource="{Binding SelectedDay.BreakfastNotes, Mode=TwoWay}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>
