<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.ShoppingListMakerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:Microsoft.Maui.Controls.Compatibility;assembly=Microsoft.Maui.Controls.Compatibility"
    xmlns:model="clr-namespace:RecipeApp.Models"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="ShoppingListMaker"
    Title="Shopping List Maker">

    <ContentPage.BindingContext>
        <viewmodels:ShoppingListMakerViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <xct:ItemTappedEventArgsConverter x:Key="ItemTappedEventArgsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding ShowHelpCommand}" IconImageSource="icon_about.png" />
        <ToolbarItem Command="{Binding ToggleSearchBarCommand}" IconImageSource="search_40.png" />
    </ContentPage.ToolbarItems>


    <StackLayout>
        <StackLayout
            Padding="10,5"
            IsVisible="{Binding SearchBarIsActive}"
            Orientation="Horizontal">
            <SearchBar
                HeightRequest="40"
                HorizontalOptions="StartAndExpand"
                Placeholder="Search Recipes"
                Text="{Binding SearchText}"
                WidthRequest="250" />
            <Picker
                Title="Filter by"
                Margin="10,0,0,0"
                ItemsSource="{Binding Filters}"
                SelectedItem="{Binding SelectedFilter}"
                VerticalOptions="CenterAndExpand" />
            <Button
                Margin="0"
                BackgroundColor="Transparent"
                Command="{Binding ClearPickerSelectionCommand}"
                Text="x" />
        </StackLayout>

        <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
            <Button
                Margin="10,10,10,0"
                Padding="5"
                Command="{Binding ClearSelectedCommand}"
                HorizontalOptions="StartAndExpand"
                Text="Deselect All" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    BackgroundColor="Transparent"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="EndAndExpand"
                    ImageSource="save_icon"
                    WidthRequest="40" />

                <Image
                    Grid.Column="0"
                    Margin="-20,0,0,0"
                    HorizontalOptions="CenterAndExpand"
                    IsVisible="{Binding SaveComplete}"
                    Source="tick_icon.png"
                    WidthRequest="40" />
            </Grid>
        </StackLayout>

        <Grid
            x:Name="TabGrid"
            Grid.Row="0"
            ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Column="0">
                <Button
                    x:Name="Tab1Button"
                    BackgroundColor="Transparent"
                    Clicked="OnTab1Clicked"
                    FontAttributes="Bold"
                    HorizontalOptions="FillAndExpand"
                    Text="Recipes"
                    TextColor="#FF6347" />
                <BoxView
                    x:Name="Tab1Box"
                    HeightRequest="5"
                    Color="#FF6347" />
            </StackLayout>
            <StackLayout Grid.Column="1">
                <Button
                    x:Name="Tab2Button"
                    BackgroundColor="Transparent"
                    Clicked="OnTab2Clicked"
                    HorizontalOptions="FillAndExpand"
                    Text="Essentials" />
                <BoxView
                    x:Name="Tab2Box"
                    HeightRequest="5"
                    IsVisible="false"
                    Color="#FF6347" />

            </StackLayout>
            <StackLayout Grid.Column="2">
                <Button
                    x:Name="Tab3Button"
                    BackgroundColor="Transparent"
                    Clicked="OnTab3Clicked"
                    HorizontalOptions="FillAndExpand"
                    Text="Snacks" />
                <BoxView
                    x:Name="Tab3Box"
                    HeightRequest="5"
                    IsVisible="false"
                    Color="#FF6347" />

            </StackLayout>
        </Grid>


        <StackLayout x:Name="Tab1Content" VerticalOptions="FillAndExpand">
            <Grid Margin="10,5,10,-10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Start"
                    Text="Name"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="End"
                    Text="Selected"
                    VerticalOptions="Center" />
            </Grid>
            <BoxView
                Margin="0,8,0,0"
                HeightRequest="2"
                HorizontalOptions="FillAndExpand"
                Color="#373737" />

            <ListView
                Margin="10"
                CachingStrategy="RecycleElement"
                HasUnevenRows="True"
                IsPullToRefreshEnabled="True"
                IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                ItemsSource="{Binding Recipes}"
                RefreshCommand="{Binding RefreshCommand}"
                SelectionMode="None"
                VerticalOptions="FillAndExpand">
                <ListView.Behaviors>
                    <behaviors:EventToCommandBehavior
                        Command="{Binding SelectedCommand}"
                        EventArgsConverter="{StaticResource ItemTappedEventArgsConverter}"
                        EventName="ItemTapped" />
                </ListView.Behaviors>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Recipe">
                        <ViewCell>
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="Medium"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding RecipeName}"
                                    VerticalOptions="Center" />

                                <CheckBox
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    IsChecked="{Binding IsSelected}"
                                    Scale="1.5"
                                    VerticalOptions="Center"
                                    Color="#FF6347" />
                            </Grid>

                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <BoxView
                Margin="0,8,0,8"
                HeightRequest="2"
                HorizontalOptions="FillAndExpand"
                Color="#373737" />
            <Button
                Margin="0,0,0,5"
                BackgroundColor="Transparent"
                Command="{Binding CreateNewRecipe}"
                HeightRequest="32"
                HorizontalOptions="Center"
                ImageSource="plus.png"
                VerticalOptions="Center"
                WidthRequest="32" />
        </StackLayout>

        <StackLayout
            x:Name="Tab2Content"
            Grid.Row="1"
            IsVisible="False"
            VerticalOptions="FillAndExpand">
            <Grid Margin="10,5,10,-10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Start"
                    Text="Name"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="End"
                    Text="Selected"
                    VerticalOptions="Center" />
            </Grid>
            <BoxView
                Margin="0,8,0,0"
                HeightRequest="2"
                HorizontalOptions="FillAndExpand"
                Color="#373737" />
            <ListView
                Margin="10"
                HasUnevenRows="True"
                HorizontalOptions="CenterAndExpand"
                IsPullToRefreshEnabled="True"
                IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                ItemsSource="{Binding Staples}"
                RefreshCommand="{Binding RefreshCommand}"
                SelectionMode="None"
                VerticalOptions="FillAndExpand">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Staple">
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem
                                    Command="{Binding Source={x:Reference ShoppingListMaker}, Path=BindingContext.DeleteStaplesCommand}"
                                    CommandParameter="{Binding .}"
                                    IsDestructive="True"
                                    Text="Delete" />
                                <MenuItem
                                    Command="{Binding Source={x:Reference ShoppingListMaker}, Path=BindingContext.EditStapleCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="Edit" />

                            </ViewCell.ContextActions>
                            <StackLayout Padding="5" Orientation="Horizontal">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="Medium"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                                <CheckBox
                                    HorizontalOptions="End"
                                    IsChecked="{Binding IsSelected}"
                                    Scale="1.5"
                                    VerticalOptions="Center"
                                    Color="#FF6347" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <BoxView
                Margin="0,8,0,8"
                HeightRequest="2"
                HorizontalOptions="FillAndExpand"
                Color="#373737" />

            <Button
                Margin="0,0,0,5"
                BackgroundColor="Transparent"
                Command="{Binding AddStapleCommand}"
                HeightRequest="32"
                HorizontalOptions="Center"
                ImageSource="plus.png"
                VerticalOptions="Center"
                WidthRequest="32" />
        </StackLayout>

        <StackLayout
            x:Name="Tab3Content"
            Grid.Row="1"
            IsVisible="False"
            VerticalOptions="FillAndExpand">
            <Grid Margin="10,5,10,-10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Start"
                    Text="Name"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="End"
                    Text="Selected"
                    VerticalOptions="Center" />
            </Grid>
            <BoxView
                Margin="0,8,0,0"
                HeightRequest="2"
                HorizontalOptions="FillAndExpand"
                Color="#373737" />
            <ListView
                Margin="10"
                HasUnevenRows="True"
                HorizontalOptions="CenterAndExpand"
                IsPullToRefreshEnabled="True"
                IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                ItemsSource="{Binding Snacks}"
                RefreshCommand="{Binding RefreshCommand}"
                SelectionMode="None"
                VerticalOptions="FillAndExpand">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Snack">
                        <ViewCell>
                            <ViewCell.ContextActions>
                                <MenuItem
                                    Command="{Binding Source={x:Reference ShoppingListMaker}, Path=BindingContext.DeleteSnackCommand}"
                                    CommandParameter="{Binding .}"
                                    IsDestructive="True"
                                    Text="Delete" />
                                <MenuItem
                                    Command="{Binding Source={x:Reference ShoppingListMaker}, Path=BindingContext.EditSnackCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="Edit" />
                            </ViewCell.ContextActions>
                            <StackLayout Padding="10" Orientation="Horizontal">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="Medium"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                                <CheckBox
                                    HorizontalOptions="End"
                                    IsChecked="{Binding IsSelected}"
                                    Scale="1.5"
                                    VerticalOptions="Center"
                                    Color="#FF6347" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <BoxView
                Margin="0,8,0,8"
                HeightRequest="2"
                HorizontalOptions="FillAndExpand"
                Color="#373737" />
            <Button
                Margin="0,0,0,5"
                BackgroundColor="Transparent"
                Command="{Binding AddSnackCommand}"
                HeightRequest="32"
                HorizontalOptions="Center"
                ImageSource="plus.png"
                VerticalOptions="Center"
                WidthRequest="32" />
        </StackLayout>

        <Grid x:Name="BtnGrid" VerticalOptions="End">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button
                Grid.Column="0"
                Margin="10,0,10,10"
                Padding="5"
                BackgroundColor="LightGreen"
                Command="{Binding GoShoppingCommand}"
                FontAttributes="Bold"
                HeightRequest="50"
                LineBreakMode="CharacterWrap"
                Text="Create new list with selected"
                TextColor="#373737" />
            <Button
                Grid.Column="1"
                Margin="10,0,10,10"
                Padding="5"
                BackgroundColor="LightGreen"
                Command="{Binding BlankShoppingCommand}"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="Add to running list"
                TextColor="#373737" />
        </Grid>
    </StackLayout>
</ContentPage>