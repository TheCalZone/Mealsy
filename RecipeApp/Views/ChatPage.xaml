<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RecipeApp.Models"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Recipe Creator">

    <ContentPage.BindingContext>
        <viewmodels:ChatViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout Margin="5">
                <Entry Placeholder="Your AI service API key" IsPassword="True" Text="{Binding ApiKey}" />
                <Button Command="{Binding SaveApiKeyCommand}" Text="Save API key on this device" />
                <Button Command="{Binding AskDessertRecipeCommand}" Text="Show me a dessert recipe" />
                <Button Command="{Binding AskRecipeCommand}" Text="Show me a recipe" />
                <StackLayout>
                    <Border
                        Margin="10"
                        Padding="0"
                        StrokeShape="RoundRectangle 10,10,10,10">
                        <Grid>
                            <Grid BackgroundColor="{DynamicResource ThemeSurface}" VerticalOptions="End">
                                <StackLayout HorizontalOptions="FillAndExpand" Spacing="5">
                                    <Label
                                        Margin="0,0,0,-10"
                                        FontAttributes="Bold"
                                        FontSize="25"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding DisplayRecipe.RecipeName}"
                                        TextColor="{DynamicResource ThemeText}"
                                        VerticalOptions="End" />
                                    <Grid
                                        Padding="10"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="FillAndExpand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Orientation="Horizontal">
                                            <Label
                                                FontSize="14"
                                                Text="Serving Size: "
                                                TextColor="{DynamicResource ThemeText}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                LineBreakMode="NoWrap"
                                                Text="{Binding DisplayRecipe.Serving}"
                                                TextColor="{DynamicResource ThemeText}" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="CenterAndExpand"
                                            Orientation="Horizontal">
                                            <Label
                                                FontSize="14"
                                                Text="Prep Time(m): "
                                                TextColor="{DynamicResource ThemeText}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                LineBreakMode="NoWrap"
                                                Text="{Binding DisplayRecipe.PrepTime}"
                                                TextColor="{DynamicResource ThemeText}" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Column="2"
                                            HorizontalOptions="EndAndExpand"
                                            Orientation="Horizontal">
                                            <Label
                                                FontSize="14"
                                                Text="Rating: "
                                                TextColor="{DynamicResource ThemeText}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                LineBreakMode="NoWrap"
                                                Text="{Binding DisplayRecipe.Rating}"
                                                TextColor="{DynamicResource ThemeText}" />
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                    <xct:Expander>
                        <xct:Expander.Header>
                            <StackLayout Orientation="Horizontal">
                                <Label
                                    Margin="10,0,0,0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Ingredients" />
                                <Image
                                    Margin="10,0,0,0"
                                    HeightRequest="18"
                                    Source="ExpandMore.png"
                                    VerticalOptions="Center"
                                    WidthRequest="18" />
                            </StackLayout>
                        </xct:Expander.Header>
                        <StackLayout>
                            <ListView
                                x:Name="IngredientsListView"
                                Grid.Row="0"
                                Margin="10"
                                HasUnevenRows="True"
                                ItemsSource="{Binding DisplayRecipe.Ingredients}"
                                RowHeight="50"
                                SelectionMode="None"
                                SeparatorColor="LightGray"
                                SeparatorVisibility="Default">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Ingredient">
                                        <ViewCell>
                                            <StackLayout
                                                Padding="10,5,10,5"
                                                Orientation="Horizontal"
                                                Spacing="0">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="18"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Name}" />
                                                <CheckBox
                                                    HorizontalOptions="EndAndExpand"
                                                    Scale="1.5"
                                                    Color="#FF6347" />
                                            </StackLayout>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackLayout>
                    </xct:Expander>
                    <xct:Expander>
                        <xct:Expander.Header>
                            <StackLayout Orientation="Horizontal">
                                <Label
                                    Margin="10,0,0,0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Recipe Method" />
                                <Image
                                    Margin="10,0,0,0"
                                    HeightRequest="18"
                                    Source="ExpandMore.png"
                                    VerticalOptions="Center"
                                    WidthRequest="18" />
                            </StackLayout>
                        </xct:Expander.Header>
                        <Label Margin="10,0,0,0" Text="{Binding DisplayRecipe.RecipeMethod}" />
                    </xct:Expander>
                </StackLayout>
                <Button Text="Save Recipe" Command="{Binding SaveRecipeCommand}"/>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
