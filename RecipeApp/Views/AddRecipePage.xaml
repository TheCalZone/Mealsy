<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.AddRecipePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RecipeApp.CustomViews"
    xmlns:converters="clr-namespace:RecipeApp.Converter"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:models="clr-namespace:RecipeApp.Models"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="AddPage"
    Title="Add new Recipe">

    <ContentPage.BindingContext>
        <viewmodels:AddRecipeViewModel />
    </ContentPage.BindingContext>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding SaveCommand}"
            Order="Primary"
            Text="Save" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <xct:ItemTappedEventArgsConverter x:Key="ItemTappedEventArgsConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Order="Secondary" Text="Import from link" Command="{Binding ImportRecipeCommand}"/>
    </ContentPage.ToolbarItems>-->

    <ContentPage.Content>
        <Grid>
            <ScrollView x:Name="AddRecipeScrollView">
                <StackLayout Margin="20">
                    <Label FontAttributes="Bold" Text="Recipe Name" />
                    <Entry Placeholder="Recipe Name" Text="{Binding RecipeName}" />
                    <!--  Header Grid  -->


                    <!--  CollectionView with Grid  -->
                    <CollectionView
                        x:Name="IngredientsCollection"
                        IsGrouped="True"
                        ItemsSource="{Binding ListOfIngredients, Mode=TwoWay}">
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate x:DataType="models:IngredientGroup">
                                <StackLayout>
                                    <Border
                                        Padding="0"
                                        BackgroundColor="#eeeeee"
                                        HeightRequest="45">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5,5,5,5" />
                                        </Border.StrokeShape>
                                        <StackLayout Orientation="Vertical">
                                            <Entry
                                                x:Name="HeaderEntry"
                                                Margin="5,0,0,0"
                                                BackgroundColor="Transparent"
                                                ClearButtonVisibility="WhileEditing"
                                                Completed="OnEntryCompleted"
                                                Focused="OnEntryFocused"
                                                FontAttributes="Bold"
                                                FontSize="Medium"
                                                HorizontalOptions="FillAndExpand"
                                                Placeholder="Section Title"
                                                PlaceholderColor="DarkGray"
                                                Text="{Binding Key, Mode=TwoWay}"
                                                TextColor="Black"
                                                VerticalOptions="CenterAndExpand"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>




                                    </Grid>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                        <CollectionView.GroupFooterTemplate>
                            <DataTemplate x:DataType="models:IngredientGroup">
                                <StackLayout
                                    Padding="10"
                                    BindingContext="{Binding .}"
                                    Orientation="Vertical">
                                    <Grid ColumnSpacing="5" HorizontalOptions="CenterAndExpand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Add Ingredient Button  -->
                                        <Button
                                            Grid.Column="0"
                                            Background="PaleGreen"
                                            Command="{Binding Source={x:Reference IngredientsCollection}, Mode=TwoWay, Path=BindingContext.AddIngredientToGroupCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Add Ingredient"
                                            TextColor="DarkSlateGrey" />

                                        <!--  Toggle Bulk Editor Visibility Button  -->
                                        <Button
                                            Grid.Column="1"
                                            BackgroundColor="DarkOrange"
                                            Command="{Binding Source={x:Reference IngredientsCollection}, Mode=TwoWay, Path=BindingContext.ShowBulkEditorForGroupCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Bulk Editor" />

                                        <!--  Remove Group Button  -->
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding Source={x:Reference IngredientsCollection}, Mode=TwoWay, Path=BindingContext.RemoveGroupCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Remove Section" />
                                    </Grid>
                                    <!--  Bulk Editor Section  -->
                                    <StackLayout IsVisible="{Binding IsGroupBulkEditorVisible}">
                                        <ScrollView>
                                            <Editor
                                                AutoSize="TextChanges"
                                                Placeholder="Bulk Ingredients"
                                                Text="{Binding BulkEditorText, Mode=TwoWay}" />
                                        </ScrollView>
                                        <!--  Bulk Add Ingredients Button  -->
                                        <Button
                                            Command="{Binding Source={x:Reference IngredientsCollection}, Mode=TwoWay, Path=BindingContext.BulkAddIngredientsCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Add Ingredients" />
                                    </StackLayout>
                                </StackLayout>
                            </DataTemplate>

                        </CollectionView.GroupFooterTemplate>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Ingredient">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="51" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="20" />
                                        <!--  For CheckBox  -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>
                                    <Editor
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Placeholder="Quantity"
                                        Text="{Binding Quantity, Mode=TwoWay}" />
                                    <Editor
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Placeholder="Ingredient"
                                        Text="{Binding Name, Mode=TwoWay}" />

                                    <Editor
                                        Grid.Column="2"
                                        Grid.Row="1"
                                        Placeholder="Tag"
                                        Text="{Binding Tag, Mode=TwoWay}" />

                                    <CheckBox
                                        Grid.Column="3"
                                        Grid.Row="1"
                                        HorizontalOptions="Fill"
                                        IsChecked="{Binding MainIngredient, Mode=TwoWay}"
                                        VerticalOptions="Center" />
                                    <ImageButton
                                        Grid.Column="4"
                                        Grid.Row="1"
                                        Command="{Binding Source={x:Reference AddPage}, Path=BindingContext.AddNoteCommand, Mode=TwoWay}"
                                        CommandParameter="{Binding .}"
                                        Scale="0.75"
                                        Source="add_note">
                                        <ImageButton.Behaviors>
                                            <xct:IconTintColorBehavior TintColor="{Binding Source={x:Reference AddPage}, Path=BindingContext.IconColor}" />
                                        </ImageButton.Behaviors>
                                    </ImageButton>
                                    <Button
                                        Grid.Column="5"
                                        Grid.Row="1"
                                        Margin="0,0,10,0"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={x:Reference AddPage}, Path=BindingContext.RemoveIngredientCommand, Mode=TwoWay}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="End"
                                        ImageSource="minus.png"
                                        Scale="0.75" />

                                    <Label
                                            Grid.Column="0"
                                        Grid.Row="0"
                                            FontAttributes="Bold"
                                            FontSize="Small"
                                            HorizontalOptions="CenterAndExpand"
                                            Text="Quantity" />
                                    <Label
                                            Grid.Column="1"
                                        Grid.Row="0"
                                            FontAttributes="Bold"
                                            FontSize="Small"
                                            HorizontalOptions="CenterAndExpand"
                                            Text="Ingredient" />
                                    <Label
                                            Grid.Column="2"
                                        Grid.Row="0"
                                            FontAttributes="Bold"
                                            HorizontalOptions="CenterAndExpand"
                                            Text="Tag" />
                                    <Label
                                            Grid.Column="3"
                                        Grid.Row="0"
                                            FontAttributes="Bold"
                                            HorizontalOptions="CenterAndExpand"
                                            Text="Key Ing" />
                                    <Label
                                            Grid.Column="4"
                                        Grid.Row="0"
                                            FontAttributes="Bold"
                                            HorizontalOptions="CenterAndExpand"
                                            Text="Note" />
                                    
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                        <Button
                            Margin="10"
                            BackgroundColor="PaleGreen"
                            Command="{Binding AddGroupCommand}"
                            Text="Add Section"
                            TextColor="DarkSlateGray" />

                    </HorizontalStackLayout>

                    <Label FontAttributes="Bold" Text="Recipe Tags" />
                    <Editor
                        Margin="0,-10,0,0"
                        AutoSize="TextChanges"
                        Placeholder="Tags (Separate each tag by a comma)"
                        Text="{Binding TagsText}" />
                    <Label FontAttributes="Bold" Text="Recipe Method" />
                    <Editor
                        AutoSize="TextChanges"
                        Placeholder="Method"
                        Text="{Binding RecipeMethod}" />
                    <xct:Expander x:Name="Optional" IsExpanded="False">
                        <xct:Expander.Header>
                            <StackLayout Margin="0,0,0,10" Orientation="Horizontal">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Optional" />
                                <ImageButton
                                    Margin="10,0,0,0"
                                    HeightRequest="18"
                                    Source="ExpandMore.png"
                                    VerticalOptions="Center"
                                    WidthRequest="18" />
                            </StackLayout>
                        </xct:Expander.Header>
                        <StackLayout>
                            <Label FontAttributes="Bold" Text="Serving Size" />
                            <Entry Placeholder="Enter a number." Text="{Binding ServingText}">
                                <Entry.Behaviors>
                                    <xct:NumericValidationBehavior
                                        InvalidStyle="{StaticResource InvalidEntryStyle}"
                                        MaximumValue="100.0"
                                        MinimumValue="1.0" />
                                </Entry.Behaviors>
                            </Entry>
                            <Label FontAttributes="Bold" Text="Prep Time" />
                            <Entry Placeholder="Enter a number." Text="{Binding PrepText}">
                                <Entry.Behaviors>
                                    <xct:NumericValidationBehavior
                                        InvalidStyle="{StaticResource InvalidEntryStyle}"
                                        MaximumValue="100.0"
                                        MinimumValue="1.0" />
                                </Entry.Behaviors>
                            </Entry>
                            <Label FontAttributes="Bold" Text="Rating" />
                            <Entry Placeholder="Enter a number." Text="{Binding RatingText}">
                                <Entry.Behaviors>
                                    <xct:NumericValidationBehavior
                                        InvalidStyle="{StaticResource InvalidEntryStyle}"
                                        MaximumValue="100.0"
                                        MinimumValue="1.0" />
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </xct:Expander>

                    <Button Command="{Binding UploadImageCommand}" Text="Upload Image" />
                    <Button Command="{Binding SaveCommand}" Text="Save" />
                </StackLayout>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</ContentPage>