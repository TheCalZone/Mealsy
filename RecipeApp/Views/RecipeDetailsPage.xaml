<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RecipeApp.Views.RecipeDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:RecipeApp.Converter"
    xmlns:local="clr-namespace:RecipeApp.Controls"
    xmlns:model="clr-namespace:RecipeApp.Models"
    xmlns:viewmodels="clr-namespace:RecipeApp.ViewModels"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="RecipeDetailsPageN"
    Title="Details">

    <ContentPage.BindingContext>
        <viewmodels:RecipeDetailsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding EditFavouriteCommand}"
            IconImageSource="{Binding StarImageSource}"
            Order="Primary" />
        <ToolbarItem
            Command="{Binding EditCommand}"
            Order="Secondary"
            Text="Edit" />
        <ToolbarItem
            Command="{Binding CopyRecipeCommand}"
            Order="Secondary"
            Text="Copy to clipboard" />
        <ToolbarItem
            Command="{Binding AddRecipeToListCommand}"
            Order="Secondary"
            Text="Add To Shopping List" />
        <ToolbarItem
            Command="{Binding DeleteRecipeCommand}"
            Order="Secondary"
            Text="Delete" />
    </ContentPage.ToolbarItems>

    <StackLayout>
        <!--  Title  -->
        <Label
            FontAttributes="Bold"
            FontFamily="Caveat"
            FontSize="36"
            HorizontalOptions="CenterAndExpand"
            Text="{Binding Recipe.RecipeName}" />
        <BoxView>
            <BoxView.HeightRequest>
                <OnPlatform x:TypeArguments="x:Double">
                    <On Platform="Android" Value="1" />
                    <On Platform="iOS" Value="0.5" />
                </OnPlatform>
            </BoxView.HeightRequest>
            <BoxView.Color>
                <OnPlatform x:TypeArguments="Color">
                    <On Platform="Android" Value="LightGray" />
                    <On Platform="iOS" Value="DarkGray" />
                </OnPlatform>
            </BoxView.Color>
        </BoxView>

