        <ScrollView VerticalOptions="FillAndExpand">
            <StackLayout>
                <StackLayout>
                    <xct:Expander
                        x:Name="IngredientsExpander"
                        Padding="0,10,0,0"
                        IsExpanded="true">
                        <xct:Expander.Header>
                            <StackLayout Orientation="Horizontal">
                                <Label
                                    Margin="10,0,0,0"
                                    FontAttributes="Bold"
                                    FontSize="Default"
                                    Text="Ingredients" />
                                <Image
                                    Margin="10,0,0,0"
                                    HeightRequest="18"
                                    Source="ExpandMore"
                                    VerticalOptions="Center"
                                    WidthRequest="18" />
                            </StackLayout>
                        </xct:Expander.Header>
                        <CollectionView
                            x:Name="IngredientsCollectionView"
                            Margin="0,20,0,0"
                            IsGrouped="True"
                            ItemsSource="{Binding GroupedIngredients}">
                            <CollectionView.GroupHeaderTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="10,0,10,0"
                                        Padding="0"
                                        BackgroundColor="#FDFDFD"
                                        HeightRequest="45"
                                        StrokeThickness="2">
                                        <Border.Stroke>
                                            <LinearGradientBrush EndPoint="0,1">
                                                <GradientStop Offset="0.1" Color="Orange" />
                                                <GradientStop Offset="1.0" Color="Brown" />
                                            </LinearGradientBrush>
                                        </Border.Stroke>
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5,5,5,5" />
                                        </Border.StrokeShape>
                                        <StackLayout Orientation="Vertical">
                                            <Label
                                                x:Name="HeaderEntry"
                                                Margin="5,0,0,0"
                                                BackgroundColor="Transparent"
                                                FontAttributes="Bold"
                                                FontSize="Medium"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Key}"
                                                TextColor="Black"
                                                VerticalOptions="CenterAndExpand"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.GroupHeaderTemplate>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="model:Ingredient">
                                    <Grid Padding="15" ColumnSpacing="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="Default"
                                            Text="{Binding Quantity}"
                                            VerticalTextAlignment="Center" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="-10">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="Default"
                                                Text="{Binding Name}"
                                                VerticalTextAlignment="Center"
                                                WidthRequest="200" />
                                            <!--  Information Icon (i) - Show only if there is a note  -->
                                            <ImageButton
                                                Command="{Binding Source={x:Reference RecipeDetailsPageN}, Path=BindingContext.ShowNoteCommand}"
                                                CommandParameter="{Binding .}"
                                                HeightRequest="20"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding HasNote}"
                                                Source="icon_about"
                                                VerticalOptions="Center">
                                                <ImageButton.Behaviors>
                                                    <xct:IconTintColorBehavior TintColor="{Binding Source={x:Reference RecipeDetailsPageN}, Path=BindingContext.IconColor}" />
                                                </ImageButton.Behaviors>
                                            </ImageButton>
                                        </HorizontalStackLayout>
                                        <CheckBox
                                            Grid.Column="2"
                                            HorizontalOptions="EndAndExpand"
                                            Scale="1.5"
                                            Color="#FF6347" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </xct:Expander>
                </StackLayout>

                <StackLayout>
                    <Button
                        Margin="10,20,10,10"
                        BackgroundColor="#FF6347"
                        Command="{Binding ShowMethodCommand}"
                        CornerRadius="5"
                        Text="Show/Hide Method"
                        TextColor="White" />
                    <Label
                        Margin="15,0,0,0"
                        FontAttributes="Bold"
                        IsVisible="{Binding MethodVisible}"
                        Text="Recipe Method" />
                    <Frame
                        Grid.Row="1"
                        Margin="10"
                        BackgroundColor="#E8E8E8"
                        BorderColor="DarkGray"
                        CornerRadius="10"
                        HasShadow="True"
                        IsVisible="{Binding MethodVisible}">
                        <ScrollView Padding="10">
                            <Label
                                FontSize="18"
                                Text="{Binding Recipe.RecipeMethod}"
                                TextColor="DarkSlateGray" />
                        </ScrollView>
                    </Frame>
                </StackLayout>
            </StackLayout>
        </ScrollView>

    </StackLayout>
</ContentPage>
